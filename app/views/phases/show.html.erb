<% content_for(:title, "#{@phase.code} #{@phase.name}｜MOGA") %>

<main class="mandala-page">
  <%# 現在地（#31） %>
  <%= breadcrumb(["Home", home_path], "#{@phase.code} #{@phase.name}") %>

  <h1 class="mandala-page__title"><%= @phase.code %> <%= @phase.name %></h1>
  <%# まだ最初の仮の名前（局面A など）のときは、名前をつけるよう声をかける %>
  <% if @phase.name == "局面#{@phase.code}" %>
    <p>ここにあなたの夢の名前をつけましょう。</p>
  <% end %>
  <p><%= link_to "この大窓の名前を直す", edit_phase_path(@phase) %></p>

  <%= render "shared/pie", percent: @phase.progress_percent, label: "この大窓の進捗率（小窓 #{@phase.windows.size} 個の平均）" %>

  <%# 小窓を 3×3 のマスに並べる（#15）。真ん中が大窓、まわりに窓1〜8 を時計回り %>
  <div class="mandala">
    <% PhasesController::WINDOW_ORDER.each do |number| %>
      <% if number == :phase %>
        <%# 真ん中の球体を押すと「なぜ」のメモへ（#145） %>
        <%= link_to edit_phase_path(@phase), class: "mandala__cell mandala__cell--me", aria: { label: "#{@phase.code} #{@phase.name}（なぜ そこへ向かうのかを書く）" } do %>
          <span class="mandala__code"><%= @phase.code %></span>
          <span class="mandala__me-name"><%= @phase.name %></span>
          <span class="mandala__me-wadachi">✎ なぜ？</span>
        <% end %>
      <% elsif (window = @windows[number]) %>
        <%# 進捗率に合わせて青の濃淡で塗る（#30） %>
        <% percent = window.progress_percent %>
        <%= link_to window_path(window), class: mandala_cell_class(percent), style: "--pct: #{percent};" do %>
          <span class="mandala__code"><%= number %></span>
          <% if (role = window_role(number)) %><span class="mandala__role"><%= role %></span><% end %>
          <span class="mandala__name"><%= window.title %></span>
          <span class="mandala__percent"><%= percent %>%</span>
        <% end %>
      <% else %>
        <%= link_to new_phase_window_path(@phase, number: number), class: "mandala__cell mandala__cell--empty" do %>
          <span class="mandala__code"><%= number %></span>
          <% if (role = window_role(number)) %><span class="mandala__role"><%= role %></span><% end %>
          <span class="mandala__name">＋ 小窓を作る</span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%# 小窓の配列の決まり（#117） %>
  <p class="mandala__rule"><%= MandalaHelper::WINDOW_ROLE_RULE %></p>

  <%# 書いたメモを小さく出す（#145） %>
  <% if @phase.memo.present? %>
    <section class="phase-memo" aria-label="なぜ そこへ向かうのか">
      <p class="phase-memo__question">なぜ　あなたはそこへ向かおうとしているのか？</p>
      <div class="phase-memo__body"><%= simple_format(@phase.memo) %></div>
    </section>
  <% end %>

  <%= render "phases/score_summary", windows: @windows.values %>

  <p><%= link_to "Homeへ戻る", home_path %></p>
</main>
