<% content_for(:title, "#{@phase.code} #{@phase.name}｜MOGA") %>

<main class="mandala-page">
  <p class="breadcrumb"><%= link_to "Home", home_path %> ＞ <%= @phase.code %> <%= @phase.name %></p>

  <h1 class="mandala-page__title"><%= @phase.code %> <%= @phase.name %></h1>
  <%# まだ最初の仮の名前（局面A など）のときは、名前をつけるよう声をかける %>
  <% if @phase.name == "局面#{@phase.code}" %>
    <p>ここにあなたの夢の名前をつけましょう。</p>
  <% end %>
  <p><%= link_to "この大窓の名前を直す", edit_phase_path(@phase) %></p>

  <%# 小窓を 3×3 のマスに並べる（#15）。真ん中が大窓、まわりに窓1〜8 を時計回り %>
  <div class="mandala">
    <% PhasesController::WINDOW_ORDER.each do |number| %>
      <% if number == :phase %>
        <div class="mandala__cell mandala__cell--me">
          <span class="mandala__code"><%= @phase.code %></span>
          <span class="mandala__me-name"><%= @phase.name %></span>
        </div>
      <% elsif (window = @windows[number]) %>
        <%= link_to window_path(window), class: "mandala__cell" do %>
          <span class="mandala__code"><%= number %></span>
          <span class="mandala__name"><%= window.title %></span>
        <% end %>
      <% else %>
        <%= link_to new_phase_window_path(@phase, number: number), class: "mandala__cell mandala__cell--empty" do %>
          <span class="mandala__code"><%= number %></span>
          <span class="mandala__name">＋ 小窓を作る</span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <p><%= link_to "Homeへ戻る", home_path %></p>
</main>
