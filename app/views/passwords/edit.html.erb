<% content_for(:title, "パスワードを変える｜MOGA") %>

<main class="form-page">
  <h1 class="form-page__title">パスワードを変える</h1>

  <p>今のパスワードと、新しいパスワードを入れてください。大窓・小窓・轍の記録は、そのまま残ります。</p>

  <%= form_with url: password_path, method: :patch, class: "form" do |f| %>
    <div class="form__field">
      <%= f.label :current_password, "今のパスワード" %>
      <%= f.password_field :current_password, autocomplete: "current-password" %>
    </div>

    <div class="form__field">
      <%= f.label :password, "新しいパスワード" %>
      <%= f.password_field :password, autocomplete: "new-password" %>
      <small>8文字以上。16文字ほどの長い合言葉がお勧めです（例：好きな言葉を4つ、ローマ字でつなぐ）。ほかの場所と同じパスワードは使わないでください。</small>
    </div>

    <div class="form__field">
      <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <%= f.submit "変える", class: "button button--primary" %>
  <% end %>

  <p><%= link_to "Home へ戻る", home_path %></p>
</main>
