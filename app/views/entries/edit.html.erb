<% content_for(:title, "記録を直す｜MOGA") %>

<main class="form-page">
  <p class="breadcrumb">
    <%= link_to "Home", home_path %> ＞
    <%= link_to "#{@phase.code} #{@phase.name}", phase_path(@phase) %> ＞
    <%= link_to "窓#{@window.number} #{@window.title}", window_path(@window) %> ＞ 記録を直す
  </p>

  <h1 class="form-page__title">記録を直す</h1>

  <%= render "entries/form", window: @window, entry: @entry %>

  <p><%= link_to "戻る", window_path(@window) %></p>
</main>
