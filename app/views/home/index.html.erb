<% content_for(:title, "Home｜MOGA") %>

<main class="mandala-page">
  <%# 現在地（#31） %>
  <%= breadcrumb("Home") %>

  <%= render "shared/pie", percent: current_user.progress_percent, label: "全体の進捗率（大窓 A〜H の平均）" %>

  <%# 最初の一歩（#115）。小窓がまだ1つも無い人にだけ、何から始めるかを示す %>
  <% if current_user.windows.none? %>
    <section class="first-step" aria-label="最初の一歩">
      <h2 class="first-step__title">最初の一歩</h2>
      <p>あなた自身で、今の自分を8つに描いてみましょう。下の A〜H のマスを1つ押し、「この大窓の名前を直す」で、あなたのテーマを書きます。</p>
      <p class="first-step__example">例：新たな仕事への挑戦、健康、地域、家族、趣味</p>
      <p class="first-step__guide"><%= link_to "くわしくは「使い方」へ", guide_path %></p>
    </section>
  <% end %>

  <div class="mandala">
    <% HomeController::MANDALA_ORDER.each do |code| %>
      <% if code == :me %>
        <%# 真ん中の丸（本人）を押すと、今日の轍が開く %>
        <%= link_to diary_path(Date.current), class: "mandala__cell mandala__cell--me", aria: { label: "#{current_user.name}（今日の轍を開く）" } do %>
          <span class="mandala__me-name"><%= current_user.name %></span>
          <span class="mandala__me-wadachi">👣 轍</span>
        <% end %>
      <% else %>
        <% phase = @phases[code] %>
        <%# 進捗率に合わせて青の濃淡で塗る（#30） %>
        <% percent = phase.progress_percent %>
        <%= link_to phase_path(phase), class: mandala_cell_class(percent), style: "--pct: #{percent};" do %>
          <span class="mandala__code"><%= phase.code %></span>
          <span class="mandala__name"><%= phase.name %></span>
          <span class="mandala__percent"><%= percent %>%</span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%# 使い方の画面への入口（#115） %>
  <p class="mandala-page__guide"><%= link_to "使い方を見る", guide_path %></p>

  <%# パスワードを変える画面・二段階認証の画面への入口（お試し中は出さない） %>
  <% unless demo? %>
    <p class="mandala-page__password"><%= link_to "パスワードを変える", edit_password_path %>　<%= link_to "二段階認証", two_factor_path %></p>
  <% end %>

  <%= button_to "ログアウト", logout_path, method: :delete, class: "button button--secondary mandala-page__logout" %>
</main>
