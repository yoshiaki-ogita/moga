<% content_for(:title, "Home｜MOGA") %>

<main class="mandala-page">
  <%# 現在地（#31） %>
  <%= breadcrumb("Home") %>

  <%= render "shared/pie", percent: current_user.progress_percent, label: "全体の進捗率（大窓 A〜H の平均）" %>

  <div class="mandala">
    <% HomeController::MANDALA_ORDER.each do |code| %>
      <% if code == :me %>
        <div class="mandala__cell mandala__cell--me">
          <span class="mandala__me-name"><%= current_user.name %></span>
        </div>
      <% else %>
        <% phase = @phases[code] %>
        <%# 進捗率に合わせて青の濃淡で塗る（#30） %>
        <% percent = phase.progress_percent %>
        <%= link_to phase_path(phase), class: mandala_cell_class(percent), style: "--pct: #{percent};" do %>
          <span class="mandala__code"><%= phase.code %></span>
          <span class="mandala__name"><%= phase.name %></span>
          <span class="mandala__percent"><%= percent %>%</span>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%= button_to "ログアウト", logout_path, method: :delete, class: "button button--secondary mandala-page__logout" %>
</main>
