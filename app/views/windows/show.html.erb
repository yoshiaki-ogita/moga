<% content_for(:title, "窓#{@window.number} #{@window.title}｜MOGA") %>

<main class="mandala-page">
  <p class="breadcrumb">
    <%= link_to "Home", home_path %> ＞
    <%= link_to "#{@phase.code} #{@phase.name}", phase_path(@phase) %> ＞
    窓<%= @window.number %> <%= @window.title %>
  </p>

  <h1 class="mandala-page__title">窓<%= @window.number %> <%= @window.title %></h1>
  <p><%= Window.human_attribute_name(:measure) %>：<%= t("activerecord.enums.window.measure.#{@window.measure}") %></p>
  <p><%= link_to "この小窓を直す", edit_window_path(@window) %></p>

  <%# 数え方で、見る物が変わる。課題型＝課題（#19〜#23）、達成率型＝記録（#24〜#27） %>
  <% if @window.plan_count? %>
    <h2>課題</h2>
    <p>課題の一覧は、これから作ります（#19〜#23）。</p>
  <% else %>
    <h2>記録</h2>
    <p>記録の一覧は、これから作ります（#24〜#27）。</p>
  <% end %>

  <%# 消す前に確認を出す（11/7 決裁） %>
  <%= button_to "この小窓を消す", window_path(@window), method: :delete,
        form: { data: { turbo_confirm: "小窓「#{@window.title}」を消します。中の課題・記録も一緒に消えて、元に戻せません。よろしいですか？" } },
        class: "button button--secondary" %>

  <p><%= link_to "#{@phase.code} #{@phase.name} へ戻る", phase_path(@phase) %></p>
</main>
