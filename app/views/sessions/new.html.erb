<% content_for(:title, "ログイン｜MOGA") %>

<main class="form-page">
  <h1 class="form-page__title">ログイン</h1>

  <%= form_with url: login_path, class: "form" do |f| %>
    <div class="form__field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, value: params[:email], autocomplete: "email" %>
    </div>

    <div class="form__field">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, autocomplete: "current-password" %>
    </div>

    <%= f.submit "ログインする", class: "button button--primary" %>
  <% end %>

  <p><%= link_to "はじめての方はユーザー登録へ", new_user_path %></p>
  <p><%= link_to "TOPへ戻る", root_path %></p>
</main>
