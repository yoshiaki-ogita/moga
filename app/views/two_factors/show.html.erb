<% content_for(:title, "二段階認証｜MOGA") %>

<main class="form-page two-factor">
  <h1 class="form-page__title">二段階認証</h1>

  <% if current_user.otp_enabled? %>
    <p class="two-factor__status two-factor__status--on">二段階認証を使っています。</p>
    <p>ログインの時に、パスワードのあと、スマホのアプリの6桁を入れます。</p>
    <p>残りの予備の鍵：<strong><%= current_user.remaining_backup_codes_count %>個</strong>（16個のうち）</p>
    <p><%= link_to "二段階認証の注意点を読む", two_factor_notice_path %></p>

    <details class="two-factor__off">
      <summary>二段階認証をやめる</summary>
      <p>やめると、次からはパスワードだけでログインします。紙の予備の鍵も使えなくなります。</p>
      <%= form_with url: two_factor_path, method: :delete, class: "form" do |f| %>
        <div class="form__field">
          <%= f.label :current_password, "今のパスワード" %>
          <%= f.password_field :current_password, autocomplete: "current-password" %>
        </div>
        <div class="form__field">
          <%= f.label :code, "アプリの6桁（または予備の鍵）" %>
          <%= f.text_field :code, autocomplete: "one-time-code", maxlength: 11, class: "two-factor__code-field" %>
        </div>
        <%= f.submit "やめる", class: "button button--secondary" %>
      <% end %>
    </details>
  <% else %>
    <p class="two-factor__status">二段階認証は、まだ使っていません。</p>
    <%# 始める前に、注意点を読んでもらう（2026-11-24 作者の決定） %>
    <%= render "shared/two_factor_notice" %>
    <p><%= link_to "二段階認証を使う", new_two_factor_path, class: "button button--primary" %></p>
  <% end %>

  <p><%= link_to "Home へ戻る", home_path %></p>
</main>
